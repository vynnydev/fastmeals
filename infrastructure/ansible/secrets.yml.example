# ============================================
# FastMeals — Ansible Vault Secrets
# ============================================
# Encrypt with: ansible-vault encrypt group_vars/secrets.yml
# Edit with:    ansible-vault edit group_vars/secrets.yml

# --- RDS Master ---
vault_rds_master_password: "CHANGE_ME"

# --- Database Passwords ---
vault_auth_db_password: "CHANGE_ME"
vault_products_db_password: "CHANGE_ME"
vault_orders_db_password: "CHANGE_ME"
vault_delivery_db_password: "CHANGE_ME"
vault_reports_db_password: "CHANGE_ME"

# --- RabbitMQ ---
vault_mq_user: "fastmeals"
vault_mq_password: "CHANGE_ME"

# --- JWT (for health check auth tests) ---
vault_jwt_access_secret: "CHANGE_ME"
