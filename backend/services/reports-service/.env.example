# Reports Service Environment Variables
NODE_ENV=development
PORT=3006

# Database (read access to all service data — CQRS read model)
DATABASE_URL=postgresql://reports_user:reports_pass@localhost:5437/reports_db

# JWT (same secret as auth-service)
JWT_ACCESS_SECRET=dev-access-secret-fastmeals-2026

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# AWS Bedrock (AI Insights)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250514
