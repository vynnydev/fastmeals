{
    "name": "@fastmeals/delivery-service",
    "version": "1.0.0",
    "description": "FastMeals Delivery Persons Microservice — CRUD + Clean Architecture",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "seed": "tsx prisma/seed.ts",
        "lint": "eslint src/ --ext .ts"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^6.19.2",
        "@prisma/client": "^6.19.2",
        "amqplib": "^0.10.9",
        "axios": "^1.13.6",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.8",
        "@types/aws-lambda": "^8.10.161",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.13.10",
        "@types/pg": "^8.18.0",
        "@types/supertest": "^6.0.2",
        "@types/swagger-ui-express": "^4.1.8",
        "prisma": "^6.19.2",
        "supertest": "^7.0.0",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3",
        "vitest": "^3.0.8"
    }
}
